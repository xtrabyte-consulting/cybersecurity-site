.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / WebStorm
.idea/

# --- Operating system files ---
.DS_Store
Thumbs.db

# --- Vercel local metadata (never commit) ---
.vercel/
vercel.json

# --- Misc ---
*.pid
*.pid.lock
*.tsbuildinfo
