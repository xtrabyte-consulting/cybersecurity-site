# --- Build output ---
dist/
.astro/

# --- Dependencies ---
node_modules/

# --- Environment variables ---
.env
.env.*        # env.local, env.production, etc.

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Editor directories/files ---
