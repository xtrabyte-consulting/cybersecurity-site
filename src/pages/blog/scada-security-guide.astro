---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SCADA Security: Protecting Industrial Control Systems" description="Essential security measures for SCADA systems in manufacturing, energy, and critical infrastructure environments.">
	<article class="blog-post">
		<div class="container">
			<header class="post-header">
				<div class="post-meta">
					<span class="category">Industrial Security</span>
					<span class="date">October 27, 2025</span>
				</div>
				<h1>SCADA Security: Protecting Industrial Control Systems</h1>
				<p class="author">By Jacob Garrett, Industrial Security Specialist</p>
			</header>

			<div class="post-content">
				<!-- INSERT YOUR POST CONTENT HTML HERE -->
			</div>

			<div class="post-footer">
				<a href="/quote" class="btn-primary">Need Help with SCADA Security?</a>
				<a href="/blog" class="btn-secondary">← Back to Blog</a>
			</div>
		</div>
	</article>
</Layout>

<style>
	.blog-post {
		padding: 4rem 0;
	}

	.post-header {
		position: relative;
		max-width: 800px;
		margin: 0 auto 3rem;
		text-align: center;
		background: var(--dark-bg);
	}

	.post-meta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.category {
		background: var(--primary-color);
		color: var(--text-light);
		padding: 0.25rem 0.75rem;
		border-radius: 0.25rem;
		font-size: 0.85rem;
		text-transform: uppercase;
		font-weight: 600;
	}

	.date {
		color: var(--text-gray);
		font-size: 0.95rem;
	}

	.post-header h1 {
		font-size: 2.0rem;
		line-height: 1.2;
		margin-bottom: 1rem;
		color: var(--text-light);
	}

	.author {
		color: var(--text-gray);
		font-size: 1rem;
	}

	.post-content {
		max-width: 800px;
		margin: 0 auto;
		line-height: 1.8;
	}

	.lead {
		font-size: 1.2rem;
		color: var(--text-gray);
		margin-bottom: 2rem;
		font-style: italic;
		padding-left: 1.5rem;
		border-left: 3px solid var(--secondary-color);
	}

	.post-content h2 {
		font-size: 2rem;
		color: var(--secondary-color);
		margin: 3rem 0 1.5rem;
	}

	.post-content h3 {
		font-size: 1.5rem;
		color: var(--text-light);
		margin: 2rem 0 1rem;
	}

	.post-content p {
		color: var(--text-light);
		margin-bottom: 1.5rem;
	}

	.post-content ul,
	.post-content ol {
		margin: 1.5rem 0;
		padding-left: 2rem;
	}

	.post-content li {
		color: var(--text-gray);
		margin-bottom: 0.75rem;
	}

	.post-content strong {
		color: var(--text-light);
	}

	.post-footer {
		max-width: 800px;
		margin: 4rem auto 0;
		padding-top: 3rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-secondary {
		background: transparent;
		border: 2px solid var(--secondary-color);
		color: var(--secondary-color);
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s;
	}

	.btn-secondary:hover {
		background: var(--secondary-color);
		color: var(--text-light);
		transform: translateY(-3px);
		box-shadow: 0 10px 30px rgba(159, 191, 42, 0.4);
		text-decoration: none;
	}

	@media (max-width: 768px) {
		.post-header h1 {
			font-size: 1.75rem;
		}

		.post-content h2 {
			font-size: 1.5rem;
		}

		.post-footer {
			flex-direction: column;
		}
	}
</style>
